{
  "name": "paseo-aide",
  "private": true,
  "version": "0.1.0",
  "description": "A proactive personal agent for Paseo: a morning brief, quiet background check-ins that speak up only when something needs you, follow-ups it schedules itself, and a log of past and planned work",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "README.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@getpaseo/client": "0.12.0"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.12.0",
    "@getpaseo/protocol": "0.12.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.4.3"
  }
}
